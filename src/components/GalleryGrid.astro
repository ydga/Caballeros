---
interface Props {
  items: {
    title?: string;
    label?: string;
    image?: string;
  }[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="gallery-grid" aria-label="Galería de imágenes">
    {items.map((item) => {
      const label = item.title || item.label || 'Fotografía';
      return (
        <figure>
          {item.image ? (
            <button
              type="button"
              data-photo-trigger
              aria-label={`Ampliar fotografía: ${label}`}
            >
              <img src={item.image} alt={label} loading="lazy" />
            </button>
          ) : (
            <div class="placeholder" role="img" aria-label={label}>
              <span>{item.label || item.title}</span>
            </div>
          )}
          {item.title && <figcaption>{item.title}</figcaption>}
        </figure>
      );
    })}
  </section>
)}

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }

  figure {
    min-width: 0;
    margin: 0;
  }

  button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: none;
    cursor: zoom-in;
  }

  img,
  .placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
  }

  img {
    object-fit: cover;
  }

  .placeholder {
    display: grid;
    box-sizing: border-box;
    place-items: end start;
    padding: 1rem;
    background:
      linear-gradient(135deg, rgb(190 30 45 / 20%), rgb(23 32 54 / 70%)),
      #f1e7e8;
  }

  .placeholder span {
    color: #fff;
    font-weight: 500;
  }

  figcaption {
    padding-top: .75rem;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
