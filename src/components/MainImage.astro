---
interface Props {
  src?: string;
  alt: string;
}

const { src, alt } = Astro.props;
---

{src && <img class="main-image" src={src} alt={alt} />}

<style>
  .main-image {
    display: block;
    width: 100%;
    max-height: 36rem;
    aspect-ratio: 16 / 9;
    margin-bottom: 1.5rem;
    border-radius: 12px;
    object-fit: cover;
  }
</style>
