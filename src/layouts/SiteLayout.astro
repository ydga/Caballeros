---
interface Props {
  title: string;
  description?: string;
  active?: string;
}

import { getCollection } from 'astro:content';

const {
  title,
  description = 'CEIP Caballeros de Santiago',
  active,
} = Astro.props;

const base = '/Caballeros';
const pages = await getCollection('pages');
const regularNavigationItems = [
  { label: 'Inicio', slug: 'home' },
  ...pages
    .filter((page) => !page.data.hide_from_navigation)
    .sort((a, b) => a.data.order - b.data.order)
    .map((page) => ({
      label: page.data.nav_label || page.data.title,
      slug: page.id,
    })),
  { label: 'Noticias', slug: 'news' },
];
const contactNavigationItem = { label: 'Contacto', slug: 'contact' };

const navigationHref = (slug: string) =>
  slug === 'home' ? `${base}/` : `${base}/${slug}/`;

const activeSlug = active;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Parkinsans:wght@400&family=Playwrite+BE+VLG:wght@100..400&family=Source+Sans+3:wght@300..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${base}/`} aria-label="Caballeros School - Inicio">
        <img
          src={`${base}/images/caballerosdesantiago.svg`}
          alt=""
          width="128"
          height="38"
        />
      </a>
      <nav aria-label="Navegacion principal">
        <div class="nav-pages">
          {regularNavigationItems.map((item) => (
            <a
              class:list={[{ active: activeSlug === item.slug }]}
              href={navigationHref(item.slug)}
            >
              {item.label}
            </a>
          ))}
        </div>
        <a
          class:list={[
            'nav-contact',
            { active: activeSlug === contactNavigationItem.slug },
          ]}
          href={navigationHref(contactNavigationItem.slug)}
        >
          {contactNavigationItem.label}
        </a>
      </nav>
    </header>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-accent: #be1e2d;
    --color-heading: #1a1917;
    --color-text: #1a1917b3;
    font-family: 'Source Sans 3', sans-serif;
    color: var(--color-text);
    background: #f8f6f1;
  }

  body {
    margin: 0;
    font-size: 16px;
  }

  .site-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    width: calc(100% - 2.5rem);
    max-width: 1200px;
    margin: 1.25rem auto 0;
    padding: .75rem .75rem .75rem 1.25rem;
    background: #fff;
    border: 1px solid #dde2ec;
    border-radius: 999px;
    box-shadow: 0 8px 30px rgb(23 32 54 / 8%);
  }

  .brand {
    display: inline-flex;
    grid-column: 1;
    justify-self: start;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  .brand img {
    display: block;
    width: auto;
    height: 48px;
  }

  .site-header nav {
    display: flex;
    grid-column: 2;
    align-items: center;
    gap: .25rem;
    justify-self: center;
    padding: .25rem;
    background: #f6f7fb;
    border-radius: 999px;
  }

  .nav-pages {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .25rem;
  }

  .site-header nav a {
    color: var(--color-text);
    font-weight: 500;
    text-decoration: none;
    padding: .55rem .75rem;
    border-radius: 999px;
  }

  .site-header nav a:hover {
    background: #f6f7fb;
    color: var(--color-heading);
  }

  .site-header nav a.active {
    background: #fff;
    color: var(--color-accent);
    box-shadow: 0 4px 16px rgb(23 32 54 / 8%);
  }

  .site-header nav a.nav-contact {
    margin-left: .25rem;
    background: var(--color-accent);
    color: #fff;
  }

  .site-header nav a.nav-contact:hover,
  .site-header nav a.nav-contact.active {
    background: #a71825;
    color: #fff;
    box-shadow: 0 4px 16px rgb(190 30 45 / 20%);
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 5rem;
  }

  .page-heading {
    max-width: 760px;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    margin: 0 0 .75rem;
    color: var(--color-accent);
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  h1 {
    margin: .25rem 0 0;
    font-size: clamp(2.25rem, 7vw, 4.5rem);
    line-height: 1.05;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    color: var(--color-heading);
    font-family: Parkinsans, sans-serif;
    font-weight: 400;
  }

  .lede {
    color: var(--color-text);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.65;
    margin: 1rem 0 0;
  }

  @media (max-width: 760px) {
    .site-header {
      display: flex;
      align-items: flex-start;
      flex-direction: column;
      margin-top: 1rem;
      border-radius: 8px;
    }

    .site-header nav {
      width: 100%;
      gap: .75rem 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav-pages {
      flex-wrap: wrap;
    }

    .site-header nav a.nav-contact {
      margin-left: 0;
    }
  }
</style>
