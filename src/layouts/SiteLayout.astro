---
interface Props {
  title: string;
  description?: string;
  active?: string;
}

import { getCollection, getEntry } from 'astro:content';

const {
  title,
  description = 'CEIP Caballeros de Santiago',
  active,
} = Astro.props;

const base = '/Caballeros';
const [pages, socialEntry] = await Promise.all([
  getCollection('pages'),
  getEntry('social', 'index'),
]);
if (!socialEntry) {
  throw new Error('Missing social links content');
}
const socialLinks = socialEntry.data;
const regularNavigationItems = [
  { label: 'Inicio', slug: 'home' },
  ...pages
    .filter((page) => !page.data.hide_from_navigation)
    .sort((a, b) => a.data.order - b.data.order)
    .map((page) => ({
      label: page.data.nav_label || page.data.title,
      slug: page.id,
    })),
  { label: 'Noticias', slug: 'news' },
];
const contactNavigationItem = { label: 'Contacto', slug: 'contact' };

const navigationHref = (slug: string) =>
  slug === 'home' ? `${base}/` : `${base}/${slug}/`;

const activeSlug = active;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Parkinsans:wght@400&family=Playwrite+BE+VLG:wght@100..400&family=Source+Sans+3:wght@300..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${base}/`} aria-label="Caballeros School - Inicio">
        <img
          src={`${base}/images/caballerosdesantiago.svg`}
          alt=""
          width="128"
          height="38"
        />
      </a>
      <nav aria-label="Navegacion principal">
        <div class="nav-pages">
          {regularNavigationItems.map((item) => (
            <a
              class:list={[{ active: activeSlug === item.slug }]}
              href={navigationHref(item.slug)}
            >
              {item.label}
            </a>
          ))}
        </div>
      </nav>
      <a
        class:list={[
          'nav-contact',
          { active: activeSlug === contactNavigationItem.slug },
        ]}
        href={navigationHref(contactNavigationItem.slug)}
      >
        {contactNavigationItem.label}
      </a>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="site-footer-content">
        <img
          class="footer-brand"
          src={`${base}/images/cds_white.svg`}
          alt="CEIP Caballeros de Santiago"
          width="231"
          height="68"
        />
        <div class="footer-school-details">
          <address>
            <p>
              <strong>CEIP Caballeros de Santiago</strong><br />
              Pl. de Valdelasgranas, 3 · Centro · 14002 Córdoba<br />
              Tel.: <a href="tel:+34957379954">957 379 954</a>,{' '}
              Móvil: <a href="tel:+34671565544">671 565 544</a><br />
              <a href="mailto:14001487.edu@juntadeandalucia.es">
                14001487.edu@juntadeandalucia.es
              </a>
            </p>
          </address>
        </div>
        <div class="footer-side">
          {(socialLinks.instagram || socialLinks.youtube || socialLinks.facebook) && (
            <nav class="footer-social-links" aria-label="Redes sociales">
              {socialLinks.instagram && (
                <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                  <svg aria-hidden="true" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                  </svg>
                </a>
              )}
              {socialLinks.youtube && (
                <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                  <svg aria-hidden="true" viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
                    <path d="M22 8a2.5 2.5 0 0 0-1.7-1.7C18.8 6 12 6 12 6s-6.8 0-8.3.3A2.5 2.5 0 0 0 2 8a26 26 0 0 0-.5 4 26 26 0 0 0 .5 4 2.5 2.5 0 0 0 1.7 1.7C5.2 18 12 18 12 18s6.8 0 8.3-.3A2.5 2.5 0 0 0 22 16a26 26 0 0 0 .5-4A26 26 0 0 0 22 8Z" />
                    <path d="m10 9 5 3-5 3z" />
                  </svg>
                </a>
              )}
              {socialLinks.facebook && (
                <a href={socialLinks.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                  <svg aria-hidden="true" viewBox="0 0 24 24" width="32" height="32" fill="currentColor">
                    <path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.884v2.27h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z" />
                  </svg>
                </a>
              )}
            </nav>
          )}
          <img
            class="footer-jda"
            src={`${base}/images/JdA.svg`}
            alt="Junta de Andalucía"
            width="135"
            height="36"
          />
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-accent: #be1e2d;
    --color-heading: #1a1917;
    --color-text: #1a1917b3;
    font-family: 'Source Sans 3', sans-serif;
    color: var(--color-text);
    background: #f8f6f1;
  }

  body {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
    margin: 0;
    font-size: 16px;
  }

  .site-header {
    position: sticky;
    top: 1rem;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    width: calc(100% - 2.5rem);
    max-width: 1200px;
    margin: 1.25rem auto 0;
    padding: .75rem .75rem .75rem 1.25rem;
    background: #fff;
    border-radius: 999px;
    box-shadow: 0 8px 30px rgb(23 32 54 / 8%);
  }

  .brand {
    display: inline-flex;
    grid-column: 1;
    justify-self: start;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  .brand img {
    display: block;
    width: auto;
    height: 48px;
  }

  .site-header nav {
    display: flex;
    grid-column: 2;
    align-items: center;
    gap: .25rem;
    justify-self: center;
    padding: .25rem;
    background: #f6f7fb;
    border-radius: 999px;
  }

  .nav-pages {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .25rem;
  }

  .site-header nav a,
  .nav-contact {
    color: var(--color-text);
    font-weight: 500;
    text-decoration: none;
    padding: .55rem .75rem;
    border-radius: 999px;
  }

  .site-header nav a:hover,
  .nav-contact:hover {
    background: #f6f7fb;
    color: var(--color-heading);
  }

  .site-header nav a.active,
  .nav-contact.active {
    background: #fff;
    color: var(--color-accent);
    box-shadow: 0 4px 16px rgb(23 32 54 / 8%);
  }

  .nav-contact {
    grid-column: 3;
    justify-self: end;
    align-self: stretch;
    display: flex;
    align-items: center;
    background: var(--color-accent);
    color: #fff;
  }

  .nav-contact:hover,
  .nav-contact.active {
    background: #a71825;
    color: #fff;
    box-shadow: 0 4px 16px rgb(190 30 45 / 20%);
  }

  main {
    flex: 1;
    width: 100%;
    box-sizing: border-box;
    max-width: 1200px;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 5rem;
  }

  .page-heading {
    max-width: 760px;
    margin: 0 0 2.5rem;
    text-align: left;
  }

  .eyebrow {
    margin: 0 0 .75rem;
    color: var(--color-accent);
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
    text-align: left;
  }

  h1 {
    margin: .25rem 0 0;
    font-size: 64px;
    line-height: 1.05;
    text-align: left;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    color: var(--color-heading);
    font-family: Parkinsans, sans-serif;
    font-weight: 400;
  }

  .lede {
    color: var(--color-text);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.65;
    margin: 1rem 0 0;
  }

  .site-footer {
    color: #fff;
    background: var(--color-accent);
  }

  .site-footer-content {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 2rem;
    row-gap: 1rem;
    box-sizing: border-box;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.25rem;
  }

  .site-footer address {
    font-style: normal;
  }

  .footer-brand {
    display: block;
    width: auto;
    max-width: 100%;
    height: 68px;
  }

  .footer-school-details {
    font-size: 14px;
    font-weight: 300;
    text-align: left;
  }

  .footer-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1rem;
  }

  .footer-social-links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-social-links a {
    display: inline-flex;
    transition: opacity 150ms ease;
  }

  .footer-social-links a:hover {
    opacity: .75;
  }

  .footer-social-links a:focus-visible {
    border-radius: 3px;
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  .footer-jda {
    justify-self: end;
    display: block;
    width: auto;
    max-width: 100%;
    height: 36px;
  }

  .footer-school-details p {
    margin: .35rem 0 0;
  }

  .site-footer a {
    color: #fff;
    font-weight: 500;
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .site-header {
      display: flex;
      align-items: flex-start;
      flex-direction: column;
      margin-top: 1rem;
      border-radius: 8px;
    }

    .site-header nav {
      width: 100%;
      gap: .75rem 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav-pages {
      flex-wrap: wrap;
    }

    .nav-contact {
      align-self: flex-end;
    }
  }

  @media (max-width: 640px) {
    .site-footer-content {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .footer-side {
      align-items: flex-start;
    }
  }
</style>
