---
interface Props {
  title: string;
  description?: string;
  active?: string;
}

import { getEntry } from 'astro:content';

const {
  title,
  description = 'Caballeros School',
  active,
} = Astro.props;

const base = '/Caballeros';
const navigationEntry = await getEntry('navigation', 'navigation');
const navigationItems = navigationEntry?.data.items ?? [
  { label: "Director's Welcome", slug: 'welcome' },
  { label: 'About', slug: 'about' },
  { label: 'Gallery', slug: 'gallery' },
  { label: 'News', slug: 'news' },
];

const normalizeNavigationSlug = (slug: string) =>
  slug.replace(/^\/|\/$/g, '');

const navigationHref = (slug: string) => {
  const normalizedSlug = normalizeNavigationSlug(slug);
  return normalizedSlug === 'news'
    ? `${base}/`
    : `${base}/${normalizedSlug}/`;
};

const activeSlug = active ? normalizeNavigationSlug(active) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${base}/`}>Caballeros School</a>
      <nav aria-label="Main navigation">
        {navigationItems.map((item) => (
          <a
            class:list={[{ active: activeSlug === normalizeNavigationSlug(item.slug) }]}
            href={navigationHref(item.slug)}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    font-family: Inter, system-ui, sans-serif;
    color: #172036;
    background: #f6f7fb;
  }

  body {
    margin: 0;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem clamp(1.25rem, 5vw, 5rem);
    background: #fff;
    border-bottom: 1px solid #dde2ec;
  }

  .brand {
    color: #172036;
    font-weight: 800;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1.25rem;
  }

  nav a {
    color: #64708a;
    font-weight: 700;
    text-decoration: none;
  }

  nav a:hover,
  nav a.active {
    color: #3155d9;
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 5rem;
  }

  .page-heading {
    max-width: 760px;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    color: #3155d9;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .12em;
  }

  h1 {
    margin: .25rem 0 1rem;
    font-size: clamp(2.25rem, 7vw, 4.5rem);
    line-height: 1.05;
  }

  .lede {
    color: #64708a;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.65;
  }

  @media (max-width: 760px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      width: 100%;
      gap: .75rem 1rem;
      flex-wrap: wrap;
    }
  }
</style>
