---
interface Props {
  title: string;
  description?: string;
  active?: string;
}

import { getCollection, getEntry } from 'astro:content';
import { faFacebook, faInstagram, faYoutube } from '@fortawesome/free-brands-svg-icons';

const {
  title,
  description = 'CEIP Caballeros de Santiago',
  active,
} = Astro.props;

const base = '/Caballeros';
const [pages, socialEntry] = await Promise.all([
  getCollection('pages'),
  getEntry('social', 'index'),
]);
if (!socialEntry) {
  throw new Error('Missing social links content');
}
const socialLinks = socialEntry.data;
const getIconData = (icon: typeof faInstagram) => {
  const [width, height, , , pathData] = icon.icon;
  return {
    viewBox: `0 0 ${width} ${height}`,
    paths: Array.isArray(pathData) ? pathData : [pathData],
  };
};
const socialIcons = {
  instagram: getIconData(faInstagram),
  youtube: getIconData(faYoutube),
  facebook: getIconData(faFacebook),
};
const regularNavigationItems = [
  { label: 'Inicio', slug: 'home' },
  ...pages
    .filter((page) => !page.data.hide_from_navigation && !page.data.parent_page)
    .sort((a, b) => a.data.order - b.data.order)
    .map((page) => ({
      label: page.data.nav_label || page.data.title,
      slug: page.id,
    })),
  { label: 'Eventos', slug: 'events' },
  { label: 'Noticias', slug: 'news' },
];
const activePage = pages.find((page) => page.id === active);
const sideNavParent = activePage?.data.parent_page
  ? pages.find((page) => page.id === activePage.data.parent_page)
  : activePage;
const sideNavItems = sideNavParent
  ? pages
      .filter(
        (page) =>
          page.data.parent_page === sideNavParent.id &&
          !page.data.hide_from_navigation,
      )
      .sort((a, b) => a.data.order - b.data.order)
  : [];
const showSideNav =
  Boolean(sideNavParent) &&
  !sideNavParent?.data.hide_from_navigation &&
  sideNavItems.length > 0;
const contactNavigationItem = { label: 'Contacto', slug: 'contact' };

const navigationHref = (slug: string) =>
  slug === 'home' ? `${base}/` : `${base}/${slug}/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Parkinsans:wght@400&family=Playwrite+BE+VLG:wght@100..400&family=Source+Sans+3:wght@300..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="nav-fade" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href={`${base}/`} aria-label="Caballeros School - Inicio">
        <img
          src={`${base}/images/caballerosdesantiago.svg`}
          alt=""
          width="128"
          height="38"
        />
      </a>
      <nav aria-label="Navegacion principal">
        <div class="nav-pages">
          {regularNavigationItems.map((item) => (
            <a
              class:list={[
                {
                  active:
                    active === item.slug ||
                    activePage?.data.parent_page === item.slug,
                },
              ]}
              href={navigationHref(item.slug)}
            >
              {item.label}
            </a>
          ))}
        </div>
      </nav>
      <a
        class:list={[
          'nav-contact',
          { active: active === contactNavigationItem.slug },
        ]}
        href={navigationHref(contactNavigationItem.slug)}
      >
        {contactNavigationItem.label}
      </a>
    </header>
    <div
      class:list={[
        'page-content',
        { 'page-content--with-sidenav': showSideNav },
      ]}
    >
      <slot />
      {showSideNav && sideNavParent && (
        <aside class="page-sidenav">
          <p class="page-sidenav-heading">
            <a
              class:list={[{ active: active === sideNavParent.id }]}
              href={navigationHref(sideNavParent.id)}
            >
              {sideNavParent.data.nav_label || sideNavParent.data.title}
            </a>
          </p>
          <nav aria-label={`Secciones de ${sideNavParent.data.nav_label || sideNavParent.data.title}`}>
            {sideNavItems.map((item) => (
              <a
                class:list={[{ active: active === item.id }]}
                href={navigationHref(item.id)}
                aria-current={active === item.id ? 'page' : undefined}
              >
                {item.data.nav_label || item.data.title}
              </a>
            ))}
          </nav>
        </aside>
      )}
    </div>
    <footer class="site-footer">
      <div class="site-footer-content">
        <img
          class="footer-brand"
          src={`${base}/images/cds_white.svg`}
          alt="CEIP Caballeros de Santiago"
          width="231"
          height="68"
        />
        <div class="footer-school-details">
          <address>
            <p>
              <strong>CEIP Caballeros de Santiago</strong><br />
              Pl. de Valdelasgranas, 3 · Centro · 14002 Córdoba<br />
              Tel.: <a href="tel:+34957379954">957 379 954</a>,{' '}
              Móvil: <a href="tel:+34671565544">671 565 544</a><br />
              <a href="mailto:14001487.edu@juntadeandalucia.es">
                14001487.edu@juntadeandalucia.es
              </a>
            </p>
          </address>
          {(socialLinks.instagram || socialLinks.youtube || socialLinks.facebook) && (
            <nav class="footer-social-links" aria-label="Redes sociales">
              {socialLinks.instagram && (
                <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                  <svg aria-hidden="true" viewBox={socialIcons.instagram.viewBox} width="16" height="16">
                    {socialIcons.instagram.paths.map((path) => <path fill="currentColor" d={path} />)}
                  </svg>
                </a>
              )}
              {socialLinks.youtube && (
                <a href={socialLinks.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                  <svg aria-hidden="true" viewBox={socialIcons.youtube.viewBox} width="16" height="16">
                    {socialIcons.youtube.paths.map((path) => <path fill="currentColor" d={path} />)}
                  </svg>
                </a>
              )}
              {socialLinks.facebook && (
                <a href={socialLinks.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                  <svg aria-hidden="true" viewBox={socialIcons.facebook.viewBox} width="16" height="16">
                    {socialIcons.facebook.paths.map((path) => <path fill="currentColor" d={path} />)}
                  </svg>
                </a>
              )}
            </nav>
          )}
        </div>
        <img
          class="footer-jda"
          src={`${base}/images/JdA.svg`}
          alt="Junta de Andalucía"
          width="135"
          height="36"
        />
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-accent: #be1e2d;
    --color-heading: #1a1917;
    --color-text: #1a1917b3;
    font-family: 'Source Sans 3', sans-serif;
    color: var(--color-text);
    background: #f8f6f1;
  }

  body {
    display: flex;
    min-height: 100vh;
    flex-direction: column;
    margin: 0;
    font-size: 16px;
  }

  .nav-fade {
    position: fixed;
    z-index: 9;
    top: 0;
    right: 0;
    left: 0;
    height: 8rem;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(248 246 241 / 100%) 0,
      rgb(248 246 241 / 96%) 52%,
      rgb(248 246 241 / 0%) 100%
    );
  }

  .site-header {
    position: sticky;
    top: 1rem;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    width: calc(100% - 2.5rem);
    max-width: 1200px;
    margin: 1.25rem auto 0;
    padding: .75rem .75rem .75rem 1.25rem;
    background: #fff;
    border-radius: 999px;
    box-shadow: 0 8px 30px rgb(23 32 54 / 8%);
  }

  .brand {
    display: inline-flex;
    grid-column: 1;
    justify-self: start;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  .brand img {
    display: block;
    width: auto;
    height: 48px;
  }

  .site-header nav {
    display: flex;
    grid-column: 2;
    align-items: center;
    gap: .25rem;
    justify-self: center;
    padding: .25rem;
    background: #f6f7fb;
    border-radius: 999px;
  }

  .nav-pages {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .25rem;
  }

  .site-header nav a,
  .nav-contact {
    color: var(--color-text);
    font-weight: 500;
    text-decoration: none;
    padding: .55rem .75rem;
    border-radius: 999px;
  }

  .site-header nav a:hover,
  .nav-contact:hover {
    background: #f6f7fb;
    color: var(--color-heading);
  }

  .site-header nav a.active,
  .nav-contact.active {
    background: #fff;
    color: var(--color-accent);
    box-shadow: 0 4px 16px rgb(23 32 54 / 8%);
  }

  .nav-contact {
    grid-column: 3;
    justify-self: end;
    align-self: stretch;
    display: flex;
    align-items: center;
    background: var(--color-accent);
    color: #fff;
  }

  .nav-contact:hover,
  .nav-contact.active {
    background: #a71825;
    color: #fff;
    box-shadow: 0 4px 16px rgb(190 30 45 / 20%);
  }

  main {
    flex: 1;
    width: 100%;
    box-sizing: border-box;
    max-width: 1200px;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 5rem;
  }

  .page-content {
    flex: 1;
    width: 100%;
  }

  .page-content--with-sidenav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    align-items: start;
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .page-content--with-sidenav > main {
    max-width: none;
    margin: 0;
  }

  .page-sidenav {
    position: sticky;
    top: 7rem;
    margin: 3.5rem 1.25rem 5rem 0;
  }

  .page-sidenav-heading {
    margin: 0 0 .75rem;
    font-weight: 600;
  }

  .page-sidenav nav {
    display: grid;
    gap: .25rem;
    padding-left: .75rem;
    border-left: 1px solid #d8d3ca;
  }

  .page-sidenav a {
    display: block;
    padding: .5rem .65rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .page-sidenav a:hover {
    color: var(--color-heading);
  }

  .page-sidenav a.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .page-heading {
    max-width: 760px;
    margin: 0 0 2.5rem;
    text-align: left;
  }

  .eyebrow {
    margin: 0 0 .75rem;
    color: var(--color-accent);
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
    text-align: left;
  }

  h1 {
    margin: .25rem 0 0;
    font-size: 64px;
    line-height: 1.05;
    text-align: left;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    color: var(--color-heading);
    font-family: Parkinsans, sans-serif;
    font-weight: 400;
    letter-spacing: -.04em;
  }

  .lede {
    color: var(--color-text);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.65;
    margin: 1rem 0 0;
  }

  .site-footer {
    color: #fff;
    background: var(--color-accent);
  }

  .site-footer-content {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 2rem;
    row-gap: 1rem;
    box-sizing: border-box;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.25rem;
  }

  .site-footer address {
    font-style: normal;
  }

  .footer-brand {
    display: block;
    width: auto;
    max-width: 100%;
    height: 68px;
  }

  .footer-school-details {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    font-size: 14px;
    font-weight: 300;
    text-align: left;
  }

  .footer-school-details address {
    flex: 1 1 20rem;
    min-width: 0;
  }

  .footer-social-links {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: .5rem;
  }

  .footer-social-links a {
    display: inline-flex;
    flex-shrink: 0;
    transition: opacity 150ms ease;
  }

  .footer-social-links a:hover {
    opacity: .75;
  }

  .footer-social-links a:focus-visible {
    border-radius: 3px;
    outline: 2px solid #fff;
    outline-offset: 4px;
  }

  .footer-jda {
    grid-column: 3;
    justify-self: end;
    display: block;
    width: auto;
    max-width: 100%;
    height: 36px;
  }

  .footer-school-details p {
    margin: .35rem 0 0;
  }

  .site-footer a {
    color: #fff;
    font-weight: 500;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .site-footer-content {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .footer-jda {
      grid-column: 2;
      justify-self: start;
    }
  }

  @media (max-width: 760px) {
    .nav-fade {
      height: 11rem;
    }

    .site-header {
      display: flex;
      align-items: flex-start;
      flex-direction: column;
      margin-top: 1rem;
      border-radius: 8px;
    }

    .site-header nav {
      width: 100%;
      gap: .75rem 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav-pages {
      flex-wrap: wrap;
    }

    .nav-contact {
      align-self: flex-end;
    }

    .page-content--with-sidenav {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .page-content--with-sidenav > main {
      grid-row: 2;
    }

    .page-sidenav {
      position: static;
      grid-row: 1;
      margin: 1rem 1.25rem 0;
    }
  }

  @media (max-width: 640px) {
    .site-footer-content {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .footer-jda {
      grid-column: 1;
    }
  }
</style>
