---
interface Props {
  title: string;
  description?: string;
  active?: string;
}

import { getCollection } from 'astro:content';

const {
  title,
  description = 'CEIP Caballeros de Santiago',
  active,
} = Astro.props;

const base = '/Caballeros';
const pages = await getCollection('pages');
const navigationItems = [
  { label: 'Inicio', slug: 'home' },
  ...pages
    .filter((page) => !page.data.hide_from_navigation)
    .sort((a, b) => a.data.order - b.data.order)
    .map((page) => ({
    label: page.data.title,
    slug: page.id,
    })),
  { label: 'Noticias', slug: 'news' },
];

const navigationHref = (slug: string) =>
  slug === 'home' ? `${base}/` : `${base}/${slug}/`;

const activeSlug = active;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Parkinsans:wght@400&family=Source+Sans+3:wght@400..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${base}/`}>Caballeros School</a>
      <nav aria-label="Navegacion principal">
        {navigationItems.map((item) => (
          <a
            class:list={[{ active: activeSlug === item.slug }]}
            href={navigationHref(item.slug)}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-accent: #be1e2d;
    --color-heading: #1a1917;
    --color-text: #1a1917b3;
    font-family: 'Source Sans 3', sans-serif;
    color: var(--color-text);
    background: #f6f7fb;
  }

  body {
    margin: 0;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem clamp(1.25rem, 5vw, 5rem);
    background: #fff;
    border-bottom: 1px solid #dde2ec;
  }

  .brand {
    color: var(--color-heading);
    font-weight: 800;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1.25rem;
  }

  nav a {
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }

  nav a:hover,
  nav a.active {
    color: var(--color-accent);
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 5rem;
  }

  .page-heading {
    max-width: 760px;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    color: var(--color-accent);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .12em;
  }

  h1 {
    margin: .25rem 0 1rem;
    font-size: clamp(2.25rem, 7vw, 4.5rem);
    line-height: 1.05;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    color: var(--color-heading);
    font-family: Parkinsans, sans-serif;
    font-weight: 400;
  }

  .lede {
    color: var(--color-text);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.65;
  }

  @media (max-width: 760px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      width: 100%;
      gap: .75rem 1rem;
      flex-wrap: wrap;
    }
  }
</style>
