---
import { getCollection, getEntry, render } from 'astro:content';
import DownloadFiles from '../components/DownloadFiles.astro';
import PhotoLightbox from '../components/PhotoLightbox.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const reserved = new Set(['about', 'gallery', 'welcome', 'contact', 'news', 'index']);
  const pages = await getCollection('pages');

  return pages
    .filter((page) => !reserved.has(page.id))
    .map((page) => ({
      params: { slug: page.id },
      props: { page },
    }));
}

const { slug } = Astro.params;
const { page } = Astro.props;
const activePage = await getEntry('pages', slug);

if (!page && !activePage) {
  return Astro.redirect('/Caballeros/');
}

const currentPage = page ?? activePage!;
const { Content } = await render(currentPage);
const galleryItems = currentPage.data.items ?? [];
---

<SiteLayout
  title={`${currentPage.data.title} | Caballeros School`}
  description={currentPage.data.lede}
  active={slug}
>
  <main>
    <header class="page-heading">
      {currentPage.data.eyebrow && <p class="eyebrow">{currentPage.data.eyebrow}</p>}
      <h1>{currentPage.data.title}</h1>
      {currentPage.data.lede && <p class="lede">{currentPage.data.lede}</p>}
    </header>
    <article class="page-card">
      <div class="content"><Content /></div>
      {galleryItems.length > 0 && (
        <div class="gallery-grid">
          {galleryItems.map((item) => (
            <figure>
              {item.image ? (
                <button
                  type="button"
                  data-photo-trigger
                  aria-label={`Ampliar fotografía: ${item.title}`}
                >
                  <img class="gallery-image" src={item.image} alt={item.title} />
                </button>
              ) : (
                <div class="placeholder" role="img" aria-label={item.title}>
                  <span>{item.label}</span>
                </div>
              )}
              <figcaption>{item.title}</figcaption>
            </figure>
          ))}
        </div>
      )}
      <DownloadFiles files={currentPage.data.downloads} />
    </article>
  </main>
  <PhotoLightbox />
</SiteLayout>

<style>
  .page-card {
    background: #fff;
    padding: clamp(1.5rem, 5vw, 3rem);
    border-radius: 16px;
    box-shadow: 0 8px 30px rgb(23 32 54 / 8%);
    line-height: 1.75;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }

  figure {
    margin: 0;
  }

  .gallery-image,
  .placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 16px;
  }

  .gallery-image {
    object-fit: cover;
  }

  .placeholder {
    display: grid;
    place-items: end start;
    box-sizing: border-box;
    padding: 1rem;
    background:
      linear-gradient(135deg, rgb(190 30 45 / 20%), rgb(23 32 54 / 70%)),
      #f1e7e8;
  }

  .placeholder span {
    color: #fff;
    font-weight: 500;
  }

  figcaption {
    padding-top: .75rem;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
