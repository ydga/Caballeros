---
import { getCollection } from 'astro:content';

const posts = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="School news and announcements" />
    <title>School News</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/Caballeros/">School News</a>
    </header>
    <main>
      <section class="intro">
        <p class="eyebrow">Latest updates</p>
        <h1>News and announcements</h1>
      </section>
      {posts.length > 0 ? (
        <div class="post-grid">
          {posts.map((post) => (
            <article class="card">
              {post.data.image && <img src={post.data.image} alt="" />}
              <p class="date">
                {post.data.date.toLocaleDateString('en', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
              <h2><a href={`/Caballeros/news/${post.id}/`}>{post.data.title}</a></h2>
              {post.data.summary && <p>{post.data.summary}</p>}
            </article>
          ))}
        </div>
      ) : (
        <p>No news posts yet.</p>
      )}
    </main>
  </body>
</html>

<style>
  :root {
    font-family: Inter, system-ui, sans-serif;
    color: #172036;
    background: #f6f7fb;
  }
  body { margin: 0; }
  .site-header {
    padding: 1.25rem clamp(1.25rem, 5vw, 5rem);
    background: #fff;
    border-bottom: 1px solid #dde2ec;
  }
  .brand { color: #172036; font-weight: 800; text-decoration: none; }
  main { max-width: 1100px; margin: 0 auto; padding: 3.5rem 1.25rem; }
  .intro { margin-bottom: 2.5rem; }
  .eyebrow { color: #3155d9; font-weight: 800; text-transform: uppercase; letter-spacing: .12em; }
  h1 { margin: .25rem 0 0; font-size: clamp(2.25rem, 7vw, 4.5rem); }
  .post-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; }
  .card { background: #fff; border-radius: 16px; padding: 1.25rem; box-shadow: 0 8px 30px rgb(23 32 54 / 8%); }
  .card img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 10px; }
  .card h2 { line-height: 1.15; }
  .card a { color: inherit; }
  .date { color: #64708a; font-size: .9rem; }
</style>
