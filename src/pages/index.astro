---
import { getCollection, getEntry } from 'astro:content';
import { ChevronLeft, ChevronRight, Pause, Play } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const base = '/Caballeros';
const [homeContent, welcomePage, aboutPage, galleryPage] = await Promise.all([
  getEntry('homepage', 'index'),
  getEntry('pages', 'welcome'),
  getEntry('pages', 'about'),
  getEntry('pages', 'gallery'),
]);

if (!homeContent || !welcomePage || !aboutPage || !galleryPage) {
  throw new Error('Missing homepage content');
}

const home = homeContent.data;
const heroSlides = home.hero_slides;
const posts = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const galleryItems = (galleryPage.data.items ?? []).slice(0, 3);
const getFullMonth = (date: Date) =>
  date.toLocaleDateString('es', { month: 'long' });
---

<SiteLayout
  title="Inicio | CEIP Caballeros de Santiago"
  description={welcomePage.data.lede ?? 'Bienvenidos a Caballeros School'}
  active="home"
>
  <main class="home">
    <section class="home-intro" aria-labelledby="home-title">
      <h1 id="home-title">Pequeñas mentes, grandes sueños, infinitas posibilidades.</h1>
      <p class="home-tagline">Enseñanza que deja huella!</p>
    </section>

    <section
      class="hero"
      data-slideshow
      aria-label="Presentación destacada"
      aria-roledescription="carrusel"
    >
      {heroSlides.map((slide, index) => (
        <article class="hero-slide" data-slide hidden={index !== 0} aria-hidden={index !== 0}>
          <img
            class="hero-image"
            src={slide.image}
            alt=""
            loading={index === 0 ? 'eager' : 'lazy'}
          />
          <div class="hero-content">
            <h2>{slide.title}</h2>
            <p class="hero-copy">{slide.subtitle}</p>
            <a class="button button-light" href={slide.cta_url}>{slide.cta_label}</a>
          </div>
        </article>
      ))}
      {heroSlides.length > 1 && (
        <div class="hero-controls" role="group" aria-label="Controles de la presentación">
          <div class="hero-dots">
            {heroSlides.map((slide, index) => (
              <button
                class="hero-dot"
                type="button"
                data-dot={index}
                aria-label={`Mostrar diapositiva ${index + 1}`}
                aria-current={index === 0 ? 'true' : undefined}
              />
            ))}
          </div>
          <div class="hero-control-actions">
            <button class="hero-control" type="button" data-previous aria-label="Diapositiva anterior">
              <ChevronLeft aria-hidden="true" size={16} />
            </button>
            <button class="hero-control" type="button" data-next aria-label="Diapositiva siguiente">
              <ChevronRight aria-hidden="true" size={16} />
            </button>
            <button
              class="hero-control hero-pause"
              type="button"
              data-pause
              aria-label="Pausar la presentación"
              aria-pressed="false"
            >
              <span class="pause-icon" aria-hidden="true"><Pause size={16} /></span>
              <span class="play-icon" aria-hidden="true" hidden><Play size={16} /></span>
            </button>
          </div>
        </div>
      )}
    </section>

    <section class="home-row about-row">
      <div>
        <p class="eyebrow">{aboutPage.data.eyebrow ?? 'Nuestra escuela'}</p>
        <h2>{aboutPage.data.title}</h2>
        {aboutPage.data.lede && <p class="row-copy">{aboutPage.data.lede}</p>}
        <a class="button" href={`${base}/about/`}>{home.about_button_label}</a>
      </div>
      <img
        class="about-logo"
        src={`${base}/images/Asset 3.svg`}
        alt=""
        width="200"
        height="200"
      />
    </section>

    <section class="home-row">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{home.news_eyebrow}</p>
          <h2>{home.news_title}</h2>
        </div>
        <a class="text-link" href={`${base}/news/`}>{home.news_link_label}</a>
      </div>
      {posts.length > 0 ? (
        <div class="post-grid">
          {posts.map((post) => (
            <article class="card">
              <div class="card-content">
                <p class="date">
                  <span class="date-day">{post.data.date.getDate()}</span>
                  <span class="date-month">{getFullMonth(post.data.date)}</span>
                </p>
                <h3><a href={`${base}/news/${post.id}/`}>{post.data.title}</a></h3>
                {post.data.summary && <p>{post.data.summary}</p>}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p>Todavía no hay noticias.</p>
      )}
    </section>

    <section class="home-row">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Nuestra comunidad</p>
          <h2>{galleryPage.data.title}</h2>
          {galleryPage.data.lede && <p class="row-copy">{galleryPage.data.lede}</p>}
        </div>
        <a class="text-link" href={`${base}/gallery/`}>{home.gallery_link_label}</a>
      </div>
      {galleryItems.length > 0 ? (
        <div class="gallery-grid">
          {galleryItems.map((item) => (
            <figure>
              {item.image ? (
                <img class="gallery-image" src={item.image} alt={item.title} />
              ) : (
                <div class="placeholder" role="img" aria-label={item.title}>
                  <span>{item.label ?? item.title}</span>
                </div>
              )}
              <figcaption>{item.title}</figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <p>Próximamente compartiremos momentos de nuestra comunidad escolar.</p>
      )}
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-footer-content">
      <a class="footer-brand" href={`${base}/`}>Caballeros School</a>
      <div class="footer-school-details">
        <address>Dirección: Pl. de Valdelasgranas, 3, Centro, 14002 Córdoba</address>
        <p>CEIP Caballeros de Santiago</p>
      </div>
      <nav aria-label="Enlaces del pie de página">
        <a href={`${base}/about/`}>Acerca</a>
        <a href={`${base}/news/`}>Noticias</a>
        <a href={`${base}/gallery/`}>Fotos</a>
      </nav>
    </div>
  </footer>
</SiteLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach((slideshow) => {
    const slides = Array.from(slideshow.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(slideshow.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const previous = slideshow.querySelector<HTMLButtonElement>('[data-previous]');
    const next = slideshow.querySelector<HTMLButtonElement>('[data-next]');
    const pause = slideshow.querySelector<HTMLButtonElement>('[data-pause]');
    const pauseIcon = pause?.querySelector<HTMLSpanElement>('.pause-icon');
    const playIcon = pause?.querySelector<HTMLSpanElement>('.play-icon');

    if (slides.length < 2 || !previous || !next || !pause || !pauseIcon || !playIcon) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeIndex = 0;
    let isPaused = false;
    let isHovered = false;
    let hasFocus = false;
    let timer: number | undefined;

    const updateTimer = () => {
      window.clearInterval(timer);
      if (!reducedMotion.matches && !isPaused && !isHovered && !hasFocus && !document.hidden) {
        timer = window.setInterval(() => showSlide(activeIndex + 1), 6000);
      }
    };

    const showSlide = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === activeIndex;
        slide.hidden = !isActive;
        slide.setAttribute('aria-hidden', String(!isActive));
      });
      dots.forEach((dot, dotIndex) => {
        if (dotIndex === activeIndex) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });
      updateTimer();
    };

    previous.addEventListener('click', () => showSlide(activeIndex - 1));
    next.addEventListener('click', () => showSlide(activeIndex + 1));
    dots.forEach((dot, index) => dot.addEventListener('click', () => showSlide(index)));
    pause.addEventListener('click', () => {
      isPaused = !isPaused;
      pause.setAttribute('aria-pressed', String(isPaused));
      pause.setAttribute(
        'aria-label',
        isPaused ? 'Reanudar la presentación' : 'Pausar la presentación',
      );
      pauseIcon.hidden = isPaused;
      playIcon.hidden = !isPaused;
      updateTimer();
    });

    slideshow.addEventListener('mouseenter', () => {
      isHovered = true;
      updateTimer();
    });
    slideshow.addEventListener('mouseleave', () => {
      isHovered = false;
      updateTimer();
    });
    slideshow.addEventListener('focusin', () => {
      hasFocus = true;
      updateTimer();
    });
    slideshow.addEventListener('focusout', (event) => {
      if (!(event.relatedTarget instanceof Node) || !slideshow.contains(event.relatedTarget)) {
        hasFocus = false;
        updateTimer();
      }
    });
    document.addEventListener('visibilitychange', updateTimer);
    reducedMotion.addEventListener('change', updateTimer);

    updateTimer();
  });
</script>

<style>
  .home {
    max-width: 1200px;
    box-sizing: border-box;
    margin: 0 auto;
    padding: 0;
  }

  .home-intro {
    width: min(1200px, calc(100% - 2.5rem));
    box-sizing: border-box;
    margin: 0 auto;
    padding: 8rem 1.5rem;
    text-align: center;
  }

  .home-intro h1 {
    font-family: Parkinsans, sans-serif;
    font-size: clamp(2.25rem, 7vw, 4rem);
    font-weight: 500;
    line-height: 1.25;
  }

  .home-intro .home-tagline {
    margin: 0;
    color: var(--color-accent);
    font-family: 'Playwrite BE VLG', cursive;
    font-size: 2em;
  }

  .hero {
    position: relative;
    width: min(1200px, calc(100% - 2.5rem));
    margin: 0 auto;
    min-height: clamp(32rem, 75vh, 48rem);
    overflow: hidden;
    border-radius: 48px;
    color: #fff;
    background: #172036;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    display: grid;
    align-items: center;
    padding: clamp(4rem, 10vw, 8rem) clamp(1.25rem, 9vw, 8rem) 6rem;
  }

  .hero-slide[hidden] {
    display: none;
  }

  .hero-slide::after {
    position: absolute;
    z-index: 1;
    background: linear-gradient(90deg, rgb(12 18 32 / 82%), rgb(12 18 32 / 25%));
    content: '';
    inset: 0;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(100%, 850px);
  }

  .hero h2 {
    max-width: 850px;
    margin: .25rem 0 1.25rem;
    color: #fff;
    font-family: Parkinsans, sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 400;
    line-height: 1.2;
  }

  .hero-copy {
    max-width: 680px;
    margin: 0 0 2rem;
    color: #e4e4e4;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.65;
  }

  .hero-controls {
    position: absolute;
    z-index: 3;
    right: clamp(1.25rem, 5vw, 5rem);
    bottom: 1.5rem;
    left: clamp(1.25rem, 5vw, 5rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
  }

  .hero-control,
  .hero-dot {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    border: 0;
    color: #fff;
    background: rgb(0 0 0 / 80%);
    cursor: pointer;
  }

  .hero-control {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
  }

  .hero-control svg {
    display: block;
  }

  .hero-dots {
    display: flex;
    align-items: center;
    gap: .5rem;
  }

  .hero-control-actions {
    display: flex;
    align-items: center;
    gap: .5rem;
  }

  .hero-dot {
    width: .75rem;
    height: .75rem;
    padding: 0;
    border-radius: 50%;
    opacity: .7;
  }

  .hero-dot[aria-current='true'] {
    background: var(--color-accent);
    opacity: 1;
  }

  .hero-control:focus-visible,
  .hero-dot:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .home-row {
    box-sizing: border-box;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(3rem, 7vw, 5rem) 1.25rem;
  }

  .about-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .about-logo {
    order: 3;
    width: 240px;
    height: 240px;
    flex-shrink: 0;
    border-radius: 50%;
  }

  .about-row .row-copy + .button {
    display: block;
    width: fit-content;
    margin-top: 1rem;
  }

  .about-row > div {
    order: 1;
  }

  .home-row h2 {
    margin: .25rem 0 0;
    font-size: clamp(1.8rem, 4vw, 2.5rem);
  }

  .row-copy {
    max-width: 720px;
    color: var(--color-text);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .section-heading h2 {
    margin-bottom: 0;
  }

  .section-heading .row-copy {
    margin-bottom: 0;
  }

  .button,
  .text-link {
    display: inline-block;
    color: var(--color-heading);
    text-decoration: none;
  }

  .text-link {
    font-weight: 800;
  }

  .button {
    flex-shrink: 0;
    padding: .8rem 1.1rem;
    border-radius: 8px;
    color: #fff;
    background: var(--color-accent);
    font-size: 18px;
    font-weight: 500;
  }

  .button-light {
    color: var(--color-heading);
    background: #fff;
  }

  .text-link:hover,
  .button:hover {
    text-decoration: underline;
  }

  .post-grid,
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .card {
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 8px 30px rgb(23 32 54 / 8%);
  }

  .card-content {
    padding: 1.25rem;
  }

  .card h3 {
    line-height: 1.2;
  }

  .card h3 a {
    color: inherit;
  }

  .date {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: fit-content;
    margin: 0 0 .75rem;
    color: var(--color-text);
    line-height: 1;
  }

  .date-day {
    color: var(--color-accent);
    font-family: Parkinsans, sans-serif;
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 500;
  }

  .date-month {
    margin-top: .25rem;
    color: var(--color-accent);
    font-size: .8rem;
    font-weight: 500;
  }

  figure {
    margin: 0;
  }

  .gallery-image,
  .placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 16px;
  }

  .gallery-image {
    object-fit: cover;
  }

  .placeholder {
    display: grid;
    place-items: end start;
    box-sizing: border-box;
    padding: 1rem;
    background: linear-gradient(135deg, rgb(190 30 45 / 20%), rgb(23 32 54 / 70%)), #f1e7e8;
  }

  .placeholder span {
    color: #fff;
    font-weight: 800;
  }

  figcaption {
    padding-top: .75rem;
    font-weight: 700;
  }

  .site-footer {
    color: #fff;
    background: #3a3a3a;
  }

  .site-footer-content {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    box-sizing: border-box;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.25rem;
  }

  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .site-footer address {
    font-style: normal;
  }

  .footer-school-details p {
    margin: .35rem 0 0;
  }

  .site-footer a {
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .about-row,
    .section-heading,
    .site-footer-content {
      align-items: flex-start;
      flex-direction: column;
    }

    .about-logo {
      width: 134px;
      height: 134px;
    }
  }
</style>
