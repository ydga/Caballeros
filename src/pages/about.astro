---
import { getEntry, render } from 'astro:content';
import DownloadFiles from '../components/DownloadFiles.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import MainImage from '../components/MainImage.astro';
import PhotoLightbox from '../components/PhotoLightbox.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const page = await getEntry('pages', 'about');
if (!page) {
  throw new Error('Missing about page content');
}
const { Content } = await render(page);
const galleryItems = page.data.items ?? [];
---

<SiteLayout
  title={`${page.data.title} | Caballeros School`}
  description={page.data.lede}
  active="about"
>
  <main>
    <header class="page-heading">
      {page.data.eyebrow && <p class="eyebrow">{page.data.eyebrow}</p>}
      <h1>{page.data.title}</h1>
      {page.data.lede && <p class="lede">{page.data.lede}</p>}
    </header>
    <div class="about-content">
      <MainImage src={page.data.main_image} alt={page.data.title} />
      <div class="about-copy"><Content /></div>
      <GalleryGrid items={galleryItems} />
      <DownloadFiles files={page.data.downloads} />
    </div>
  </main>
  <PhotoLightbox />
</SiteLayout>

<style>
  .about-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: #fff;
    padding: 1.5rem;
    border-radius: 16px;
    box-shadow: 0 8px 30px rgb(23 32 54 / 8%);
    line-height: 1.7;
  }

  .about-copy :global(h2),
  .about-copy :global(p) {
    margin-top: 0;
  }
</style>
