---
import { getEntry, render } from 'astro:content';
import DownloadFiles from '../components/DownloadFiles.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import PhotoLightbox from '../components/PhotoLightbox.astro';
import SiteLayout from '../layouts/SiteLayout.astro';

const page = await getEntry('pages', 'gallery');
if (!page) {
  throw new Error('Missing gallery page content');
}
const { Content } = await render(page);
const galleryItems = page.data.items ?? [];
---

<SiteLayout
  title={`${page.data.title} | Caballeros School`}
  description={page.data.lede}
  active="gallery"
>
  <main>
    <header class="page-heading">
      {page.data.eyebrow && <p class="eyebrow">{page.data.eyebrow}</p>}
      <h1>{page.data.title}</h1>
      {page.data.lede && <p class="lede">{page.data.lede}</p>}
    </header>

    <div class="content"><Content /></div>
    <GalleryGrid items={galleryItems} />
    <DownloadFiles files={page.data.downloads} />
  </main>
  <PhotoLightbox />
</SiteLayout>
