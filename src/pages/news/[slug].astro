---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<SiteLayout title={`${post.data.title} | Caballeros School`} active="news">
  <main class="article-main">
    <a class="back" href="/Caballeros/">&larr; Todas las noticias</a>
    <article>
      <p class="date">
        {post.data.date.toLocaleDateString('es', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </p>
      <h1>{post.data.title}</h1>
      {post.data.image && <img class="hero" src={post.data.image} alt="" />}
      <div class="content"><Content /></div>
    </article>
  </main>
</SiteLayout>

<style>
  .article-main { max-width: 760px; }
  .back { color: var(--color-accent); text-decoration: none; }
  article { background: #fff; margin-top: 1.25rem; padding: clamp(1.25rem, 5vw, 3rem); border-radius: 16px; }
  h1 { margin: .25rem 0 1.5rem; font-size: clamp(2.25rem, 7vw, 4rem); line-height: 1.05; }
  .date { color: var(--color-text); }
  .hero { width: 100%; max-height: 430px; object-fit: cover; border-radius: 12px; }
  .content { line-height: 1.75; font-size: 1.08rem; }
</style>
