---
import { getCollection, render } from 'astro:content';
import DownloadFiles from '../../components/DownloadFiles.astro';
import PhotoLightbox from '../../components/PhotoLightbox.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const galleryItems = post.data.gallery ?? [];
---

<SiteLayout title={`${post.data.title} | Caballeros School`} active="news">
  <main class="article-main">
    <a class="back" href="/Caballeros/">&larr; Todas las noticias</a>
    <article>
      <p class="date">
        {post.data.date.toLocaleDateString('es', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </p>
      <h1>{post.data.title}</h1>
      <div class="content"><Content /></div>
      <DownloadFiles files={post.data.downloads} />
      {galleryItems.length > 0 && (
        <section class="news-gallery" aria-label="Galeria de imagenes">
          {galleryItems.map((item) => (
            <figure>
              <button
                type="button"
                data-photo-trigger
                aria-label={`Ampliar fotografía: ${item.title || post.data.title}`}
              >
                <img src={item.image} alt={item.title || post.data.title} />
              </button>
              {item.title && <figcaption>{item.title}</figcaption>}
            </figure>
          ))}
        </section>
      )}
    </article>
  </main>
  <PhotoLightbox />
</SiteLayout>

<style>
  .article-main { max-width: 960px; }
  .back { color: var(--color-accent); text-decoration: none; }
  article { background: #fff; margin-top: 1.25rem; padding: clamp(1.25rem, 5vw, 3rem); border-radius: 16px; }
  h1 { margin: .25rem 0 1.5rem; line-height: 1.05; }
  .date { color: var(--color-text); }
  .content { line-height: 1.75; font-size: 1.08rem; }
  .content :global(img) { display: none; }
  .news-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }
  figure { margin: 0; }
  button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  button img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 12px;
  }
  figcaption { padding-top: .75rem; font-weight: 700; }
</style>
