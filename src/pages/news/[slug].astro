---
import { getCollection, render } from 'astro:content';
import DownloadFiles from '../../components/DownloadFiles.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import MainImage from '../../components/MainImage.astro';
import PhotoLightbox from '../../components/PhotoLightbox.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const galleryItems = post.data.gallery ?? [];
---

<SiteLayout title={`${post.data.title} | Caballeros School`} active="news">
  <main class="article-main">
    <a class="back" href="/caballeros/">&larr; Todas las noticias</a>
    <article>
      <p class="date">
        {post.data.date.toLocaleDateString('es', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </p>
      <h1>{post.data.title}</h1>
      <MainImage src={post.data.main_image} alt={post.data.title} />
      <div class="content"><Content /></div>
      <GalleryGrid items={galleryItems} />
      <DownloadFiles files={post.data.downloads} />
    </article>
  </main>
  <PhotoLightbox />
</SiteLayout>

<style>
  .article-main { max-width: 960px; }
  .back { color: var(--color-accent); text-decoration: none; }
  article { background: #fff; margin-top: 1.25rem; padding: clamp(1.25rem, 5vw, 3rem); border-radius: 16px; }
  h1 { margin: .25rem 0 1.5rem; line-height: 1.05; }
  .date { color: var(--color-text); }
  .content { line-height: 1.75; font-size: 1.08rem; }
  .content :global(img) { display: none; }
</style>
