---
import { getCollection } from 'astro:content';
import PhotoLightbox from '../../components/PhotoLightbox.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const base = '/Caballeros';
const posts = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const getFeaturedImage = (post: (typeof posts)[number]) => {
  if (post.data.main_image) {
    return { src: post.data.main_image, alt: post.data.title };
  }

  const firstGalleryImage = post.data.gallery?.[0];
  return firstGalleryImage
    ? {
        src: firstGalleryImage.image,
        alt: firstGalleryImage.title || post.data.title,
      }
    : undefined;
};
---

<SiteLayout
  title="Noticias escolares | Caballeros School"
  description="Noticias y anuncios escolares"
  active="news"
>
  <main>
    <section class="intro">
      <p class="eyebrow">Ultimas novedades</p>
      <h1>Noticias y anuncios</h1>
    </section>
    {posts.length > 0 ? (
      <div class="post-grid">
        {posts.map((post) => {
          const featuredImage = getFeaturedImage(post);
          const galleryItems = post.data.gallery?.slice(post.data.main_image ? 0 : 1) ?? [];
          return (
            <article class="card">
              {featuredImage && (
                <a
                  class="card-image"
                  href={`${base}/news/${post.id}/`}
                  aria-label={`Leer noticia: ${post.data.title}`}
                >
                  <img
                    src={featuredImage.src}
                    alt={featuredImage.alt}
                    loading="lazy"
                  />
                </a>
              )}
              <div class="card-content">
                <time class="date" datetime={post.data.date.toISOString().slice(0, 10)}>
                  {post.data.date.toLocaleDateString('es-ES', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                    timeZone: 'UTC',
                  })}
                </time>
                <h2><a href={`${base}/news/${post.id}/`}>{post.data.title}</a></h2>
                {post.data.summary && <p>{post.data.summary}</p>}
              </div>
              {galleryItems.length > 0 && (
                <div class="news-gallery" aria-label={`Galeria: ${post.data.title}`}>
                  {galleryItems.map((item) => (
                    <figure>
                      <button
                        type="button"
                        data-photo-trigger
                        aria-label={`Ampliar fotografía: ${item.title || post.data.title}`}
                      >
                        <img
                          src={item.image}
                          alt={item.title || post.data.title}
                          loading="lazy"
                        />
                      </button>
                      {item.title && <figcaption>{item.title}</figcaption>}
                    </figure>
                  ))}
                </div>
              )}
            </article>
          );
        })}
      </div>
    ) : (
      <p>Todavía no hay noticias.</p>
    )}
  </main>
  <PhotoLightbox />
</SiteLayout>

<style>
  .intro { margin-bottom: 2.5rem; }
  .post-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; }
  .card { background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 30px rgb(23 32 54 / 8%); }
  .card-image { display: block; }
  .card-image img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .card-content { padding: 1.25rem; }
  .card h2 { line-height: 1.15; }
  .card a { color: inherit; }
  .date { display: block; width: fit-content; margin: 0 0 .75rem; color: var(--color-text); font-size: .85rem; line-height: 1.4; }
  .news-gallery { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .5rem; padding: 0 1.25rem 1.25rem; }
  .news-gallery figure { min-width: 0; margin: 0; }
  .news-gallery button { border-radius: 8px; }
  .news-gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; }
  .news-gallery figcaption { padding-top: .4rem; font-size: .8rem; }
  @media (max-width: 640px) { .news-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
