---
import { getCollection } from 'astro:content';
import PhotoLightbox from '../../components/PhotoLightbox.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const base = '/Caballeros';
const posts = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const getFullMonth = (date: Date) =>
  date.toLocaleDateString('es', { month: 'long' });
---

<SiteLayout
  title="Noticias escolares | Caballeros School"
  description="Noticias y anuncios escolares"
  active="news"
>
  <main>
    <section class="intro">
      <p class="eyebrow">Ultimas novedades</p>
      <h1>Noticias y anuncios</h1>
    </section>
    {posts.length > 0 ? (
      <div class="post-grid">
        {posts.map((post) => (
          <article class="card">
            <div class="card-content">
              <p class="date">
                <span class="date-day">{post.data.date.getDate()}</span>
                <span class="date-month">{getFullMonth(post.data.date)}</span>
              </p>
              <h2><a href={`${base}/news/${post.id}/`}>{post.data.title}</a></h2>
              {post.data.summary && <p>{post.data.summary}</p>}
            </div>
            {post.data.gallery && post.data.gallery.length > 0 && (
              <div class="news-gallery" aria-label={`Galeria: ${post.data.title}`}>
                {post.data.gallery.map((item) => (
                  <figure>
                    <button
                      type="button"
                      data-photo-trigger
                      aria-label={`Ampliar fotografía: ${item.title || post.data.title}`}
                    >
                      <img
                        src={item.image}
                        alt={item.title || post.data.title}
                        loading="lazy"
                      />
                    </button>
                    {item.title && <figcaption>{item.title}</figcaption>}
                  </figure>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    ) : (
      <p>Todavía no hay noticias.</p>
    )}
  </main>
  <PhotoLightbox />
</SiteLayout>

<style>
  .intro { margin-bottom: 2.5rem; }
  .post-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; }
  .card { background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 8px 30px rgb(23 32 54 / 8%); }
  .card-content { padding: 1.25rem; }
  .card h2 { line-height: 1.15; }
  .card a { color: inherit; }
  .date { display: flex; flex-direction: column; align-items: flex-start; width: fit-content; margin: 0 0 .75rem; color: var(--color-text); line-height: 1; }
  .date-day { color: var(--color-accent); font-family: Parkinsans, sans-serif; font-size: clamp(2.25rem, 5vw, 3.25rem); font-weight: 500; }
  .date-month { margin-top: .25rem; color: var(--color-accent); font-size: .8rem; font-weight: 500; }
  .news-gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: .5rem; padding: 0 1.25rem 1.25rem; }
  .news-gallery figure { min-width: 0; margin: 0; }
  .news-gallery button { border-radius: 8px; }
  .news-gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; }
  .news-gallery figcaption { padding-top: .4rem; font-size: .8rem; }
</style>
